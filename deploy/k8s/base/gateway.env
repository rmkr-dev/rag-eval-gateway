SPRING_CONFIG_ADDITIONAL_LOCATION=optional:file:/config/gateway.yml
SPRING_CONFIG_IMPORT=optional:configtree:/mnt/secrets/
SPRING_DATASOURCE_URL=jdbc:postgresql://REPLACE_ME.postgres.database.azure.com:5432/gateway?sslmode=require
SPRING_DATASOURCE_USERNAME=gateway
ENTRA_SECURITY_TENANTID=REPLACE_ME
ENTRA_SECURITY_CLIENTID=REPLACE_ME
MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE=readinessState,db
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=50 -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/tmp
